#!/bin/sh
set -eu

select_python() {
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1 && \
            "$candidate" -c 'import sys; raise SystemExit(sys.version_info[:2] not in {(3, 12), (3, 13), (3, 14)})' >/dev/null 2>&1
        then
            printf '%s\n' "$candidate"
            return
        fi
    done
    printf >&2 'X5 Crop verification requires Python 3.12, 3.13, or 3.14.\n'
    exit 2
}

PYTHON=$(select_python)

check_staged() {
    git diff --cached --check
    git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
        case "/$path" in
            */.DS_Store|/.venv/*|/.venv-build/*|/build/*|/dist/*|/release/*|/downloaded_apps/*|/Test/*|/x5_crop_output/*)
                printf >&2 'Refusing generated or local file: %s\n' "$path"
                exit 1
                ;;
        esac
        case "$path" in
            *.[Tt][Ii][Ff]|*.[Tt][Ii][Ff][Ff])
                [ "$(git check-attr filter -- "$path")" = "$path: filter: lfs" ] || {
                    printf >&2 'TIFF fixtures must be explicitly tracked by Git LFS: %s\n' "$path"
                    exit 1
                }
                ;;
        esac
    done
}

check_diff_hygiene() {
    git diff --check
    git diff --cached --check
    if git diff --quiet && git diff --cached --quiet && \
        git rev-parse --verify HEAD^ >/dev/null 2>&1
    then
        git diff --check HEAD^ HEAD
    fi
}

check_pushed_documentation() {
    refs=$1
    while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "$local_ref" ] || continue
        git diff --check "$remote_sha" "$local_sha"
    done <"$refs"
    check_diff_hygiene
}

run_full() {
    "$PYTHON" -m unittest discover -s tools/tests
    "$PYTHON" -m compileall -q X5_Crop.py x5crop tools
    "$PYTHON" -m x5crop.configuration.consistency
    for script in \
        X5_Crop_Mac.command \
        tools/install/X5_Crop_Mac_install.command \
        tools/install/X5_Crop_Mac_uninstall.command
    do
        [ ! -f "$script" ] || bash -n "$script"
    done
    check_diff_hygiene
    "$PYTHON" X5_Crop.py --version
}

check_performance_receipt() {
    candidate_commit=$(git rev-parse HEAD)
    "$PYTHON" -m tools.regression.performance \
        --check-receipt build/v5-performance/performance_receipt.json \
        --expected-commit "$candidate_commit"
}

case "${1:-}" in
    staged)
        check_staged
        ;;
    full)
        run_full
        ;;
    accuracy)
        "$PYTHON" -m tools.regression.accuracy
        ;;
    diagnostic)
        "$PYTHON" -m tools.regression.diagnostic_cohort
        ;;
    performance)
        "$PYTHON" -m tools.regression.performance
        ;;
    non-detection)
        "$PYTHON" -m tools.regression.non_detection_freeze
        ;;
    audit)
        "$PYTHON" -m tools.regression.non_detection_freeze --audit-only
        ;;
    platform)
        shift
        "$PYTHON" -m tools.regression.platform_receipt "$@"
        ;;
    platform-check)
        shift
        "$PYTHON" -m tools.regression.platform_check "$@"
        ;;
    platform-package)
        shift
        "$PYTHON" -m tools.regression.platform_package "$@"
        ;;
    pre-push)
        [ -z "$(git status --porcelain)" ] || {
            printf >&2 'Refusing push from a dirty worktree. Commit intentional changes first.\n'
            exit 1
        }
        scope=runtime
        if [ -n "${2:-}" ] && [ -f "$2" ]; then
            scope=$("$PYTHON" -m tools.verification_scope --refs "$2")
        fi
        case "$scope" in
            documentation)
                check_pushed_documentation "$2"
                ;;
            full)
                run_full
                ;;
            runtime)
                check_performance_receipt
                run_full
                ;;
            *)
                printf >&2 'Unknown verification scope: %s\n' "$scope"
                exit 2
                ;;
        esac
        ;;
    *)
        printf >&2 '%s\n' \
            "usage: $0 staged|full|accuracy|diagnostic|performance|non-detection|audit|platform|platform-check|platform-package|pre-push"
        exit 2
        ;;
esac
